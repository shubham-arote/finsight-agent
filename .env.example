# ── provider keys (ALL optional — every feature degrades gracefully without its key) ──
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio (Gemini — vision OCR fallback + eval judge): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cohere (embed + rerank + answer fallback): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ── role → model fallback chains (comma-separated LiteLLM model ids, first = primary) ──
# Models whose provider key is missing are skipped automatically.
# LLM_FAST=groq/llama-3.3-70b-versatile,gemini/gemini-2.5-flash,openrouter/meta-llama/llama-3.3-70b-instruct:free
# LLM_ANSWER=groq/llama-3.3-70b-versatile,cohere/command-a-03-2025,gemini/gemini-2.5-flash
# LLM_VISION=gemini/gemini-2.5-flash,groq/meta-llama/llama-4-scout-17b-16e-instruct
# LLM_JUDGE=gemini/gemini-2.5-flash

# seconds a model is skipped after a rate-limit / provider error
# LLM_COOLDOWN_S=60

# ── Google Vertex AI — the SCALE path (large eval runs, production quotas) ──
# Auth is ADC (week3 reference pattern): `gcloud auth application-default login`
# or GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON. Then put
# vertex_ai/* models in the chains, e.g.:
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=us-central1
# LLM_JUDGE=vertex_ai/gemini-2.5-flash

# ── observability (Langfuse — optional; JSONL traces always on) ──
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# TRACES_PATH=logs/traces.jsonl

# ── MCP retrieval sidecar (set by docker-compose / Cloud Run; empty = in-process) ──
# MCP_SERVER_URL=http://mcp:3000/mcp
# MCP_PORT=3000

# ── ingestion / retrieval ──
# ARTIFACTS_DB=data/artifacts.db     # page-parse + chunk-context cache (OCR runs once)
# CONTEXTUAL_CHUNKS=1                # LLM context prefix per chunk (needs any fast key)
# QDRANT_URL=                        # empty -> in-process :memory: (keyless dev/tests)
# QDRANT_API_KEY=
# QDRANT_COLLECTION=finsight_chunks
# EMBED_MODEL=cohere/embed-v4.0      # dense embeddings; sparse-only without COHERE_API_KEY
